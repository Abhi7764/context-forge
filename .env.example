# ContextForge Environment Variables
# Copy this file to .env and fill in your API keys.
# Only add keys for the providers you intend to use.

# --- Application ---
# Environment: "development" (reload, debug) or "production" (multi-worker, no reload)
ENV=development

# Number of uvicorn workers in production mode
WORKERS=4

# API key for authenticating requests (optional — leave empty to disable auth)
# When set, all requests must include the header: X-API-Key: <your_key>
# API_KEY=your_secret_api_key_here

# CORS allowed origins (comma-separated). Use "*" to allow all origins.
CORS_ORIGINS=*

# --- Vector Database ---
# Required when vector_db.provider = pinecone
PINECONE_API_KEY=your_pinecone_api_key_here

# --- LLM Providers (add key for the one you use) ---
# Required when llm.provider = openai
OPENAI_API_KEY=your_openai_api_key_here

# Required when llm.provider = anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required when llm.provider = gemini
GOOGLE_API_KEY=your_google_api_key_here

# Ollama requires no API key (runs locally)
